#!/usr/bin/env bash
# brave-origin-install — one-command NixOS + Brave Origin installer
#
# Usage:
#   brave-origin-install /dev/sdX
#   brave-origin-install /dev/nvme0n1
#
# What it does:
#   1. Wipes and partitions the target disk (EFI + root)
#   2. Formats and mounts the partitions
#   3. Runs nixos-generate-config
#   4. Drops in a ready-made flake.nix (brave-origin-nix wired in)
#   5. Runs nixos-install — Brave Origin is fetched here, not from the ISO
#
# The installed system has:
#   - Brave Origin (via brave-origin-nix flake)
#   - Ratpoison window manager  (startx to launch)
#   - home-manager ready to apply home.nix after first boot
#
set -euo pipefail

# ── Colour helpers ────────────────────────────────────────────────────────────
red()    { printf '\033[1;31m%s\033[0m\n' "$*"; }
green()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[1;33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n'   "$*"; }
die()    { red "ERROR: $*"; exit 1; }

# ── Root check ────────────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "Run as root: sudo brave-origin-install /dev/sdX"

# ── Argument ──────────────────────────────────────────────────────────────────
DISK="${1:-}"
[[ -n "$DISK" ]] || { bold "Usage: brave-origin-install /dev/sdX"; exit 1; }
[[ -b "$DISK" ]] || die "$DISK is not a block device"

# ── Detect partition suffix (nvme uses p1/p2, sata uses 1/2) ─────────────────
if [[ "$DISK" =~ nvme|mmcblk ]]; then
  EFI="${DISK}p1"
  ROOT="${DISK}p2"
else
  EFI="${DISK}1"
  ROOT="${DISK}2"
fi

# ── Confirm ───────────────────────────────────────────────────────────────────
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
bold " Brave Origin NixOS Installer"
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo
yellow "  Target disk : $DISK"
yellow "  EFI         : $EFI  (512 MiB, FAT32)"
yellow "  Root        : $ROOT (rest of disk, ext4)"
echo
red    "  ALL DATA ON $DISK WILL BE DESTROYED."
echo
read -rp "  Type YES to continue: " confirm
[[ "$confirm" == "YES" ]] || { echo "Aborted."; exit 0; }

# ── Optional: username and password ──────────────────────────────────────────
echo
read -rp "  Username [user]: " USERNAME
USERNAME="${USERNAME:-user}"

while true; do
  read -rsp "  Password for $USERNAME: " PASSWORD; echo
  read -rsp "  Confirm password: "        CONFIRM;  echo
  [[ "$PASSWORD" == "$CONFIRM" ]] && break
  yellow "Passwords do not match, try again."
done

# ── Optional: hostname ────────────────────────────────────────────────────────
read -rp "  Hostname [brave-origin]: " HOSTNAME
HOSTNAME="${HOSTNAME:-brave-origin}"

# ── Optional: timezone ────────────────────────────────────────────────────────
DETECTED_TZ="$(timedatectl show --property=Timezone --value 2>/dev/null || echo UTC)"
read -rp "  Timezone [$DETECTED_TZ]: " TIMEZONE
TIMEZONE="${TIMEZONE:-$DETECTED_TZ}"

echo
green "Starting installation…"
echo

# ── 1. Partition ──────────────────────────────────────────────────────────────
bold "[ 1/6 ] Partitioning $DISK…"
sgdisk --zap-all "$DISK"
sgdisk --new=1:0:+512M --typecode=1:ef00 --change-name=1:"EFI"  "$DISK"
sgdisk --new=2:0:0     --typecode=2:8300 --change-name=2:"NixOS" "$DISK"
partprobe "$DISK"
sleep 1

# ── 2. Format ─────────────────────────────────────────────────────────────────
bold "[ 2/6 ] Formatting…"
mkfs.vfat  -F32 -n EFI   "$EFI"
mkfs.ext4  -L   NixOS    "$ROOT"

# ── 3. Mount ──────────────────────────────────────────────────────────────────
bold "[ 3/6 ] Mounting…"
mount "$ROOT" /mnt
mkdir -p /mnt/boot/efi
mount "$EFI"  /mnt/boot/efi

# ── 4. Generate hardware config ───────────────────────────────────────────────
bold "[ 4/6 ] Generating hardware configuration…"
nixos-generate-config --root /mnt

# ── 5. Write flake.nix ────────────────────────────────────────────────────────
bold "[ 5/6 ] Writing system configuration…"
cat > /mnt/etc/nixos/flake.nix << FLAKE
{
  description = "Brave Origin NixOS — $HOSTNAME";

  inputs = {
    nixpkgs.url          = "github:NixOS/nixpkgs/nixos-unstable";
    brave-origin-nix.url = "github:legendarymsr/brave-origin-nix";
    brave-origin-nix.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, brave-origin-nix }:
  {
    nixosConfigurations.system = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [
        ./hardware-configuration.nix
        brave-origin-nix.nixosModules.brave-origin
        ({ config, pkgs, lib, ... }: {

          boot.loader.systemd-boot.enable      = true;
          boot.loader.efi.canTouchEfiVariables = true;

          networking.hostName              = "$HOSTNAME";
          networking.networkmanager.enable = true;

          time.timeZone      = "$TIMEZONE";
          i18n.defaultLocale = "en_US.UTF-8";

          # Brave Origin — fetched from GitHub during this install
          programs.brave-origin.enable = true;

          services.xserver = {
            enable                         = true;
            windowManager.ratpoison.enable = true;
          };

          users.users.$USERNAME = {
            isNormalUser = true;
            extraGroups  = [ "wheel" "networkmanager" "video" "audio" ];
          };

          environment.systemPackages = with pkgs; [
            git curl htop xterm dejavu_fonts
          ];

          environment.etc.".xinitrc".text = ''
            #!/bin/sh
            xsetroot -cursor_name left_ptr
            exec ratpoison
          '';

          nix.settings.experimental-features = [ "nix-command" "flakes" ];
          system.stateVersion = "25.05";
        })
      ];
    };
  };
}
FLAKE

# ── 6. Install ────────────────────────────────────────────────────────────────
bold "[ 6/6 ] Running nixos-install (Brave Origin fetched from GitHub)…"
nixos-install \
  --flake /mnt/etc/nixos#system \
  --no-root-passwd \
  --option substituters "https://cache.nixos.org" \
  --option trusted-public-keys "cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="

# ── Set password ──────────────────────────────────────────────────────────────
echo "$USERNAME:$PASSWORD" | nixos-enter --root /mnt -- chpasswd

# ── Done ──────────────────────────────────────────────────────────────────────
echo
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
green " Installation complete!"
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo
echo "  Remove the USB drive and reboot:"
echo
echo "    reboot"
echo
echo "  After login, start the graphical session:"
echo
echo "    startx"
echo
echo "  Brave Origin is in Ratpoison as: C-t b"
echo
